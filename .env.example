# 복사해서 .env 로 사용한다. .env 는 커밋하지 않는다.
#   cp .env.example .env && 비밀번호를 바꾼다 (예: openssl rand -hex 24)
# docker compose 는 이 파일을 자동으로 읽고, POSTGRES_PASSWORD 가 없으면 기동하지 않는다.
POSTGRES_DB=stockdb
POSTGRES_USER=stockuser
POSTGRES_PASSWORD=change-me

# 호스트 venv 에서 배치를 돌릴 때: set -a; source ../.env; set +a
# DATABASE_URL 을 비워 두면 위 POSTGRES_* 값으로 localhost:5432 에 접속한다.
REDIS_URL=redis://localhost:6379/0
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
CORS_ORIGINS=http://localhost:3000
