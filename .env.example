# 복사해서 .env 로 사용한다. .env 는 커밋하지 않는다.
POSTGRES_DB=stockdb
POSTGRES_USER=stockuser
POSTGRES_PASSWORD=change-me

# 호스트 venv 에서 배치를 돌릴 때 사용 (컨테이너는 docker-compose.yml 값을 쓴다)
DATABASE_URL=postgresql://stockuser:change-me@localhost:5432/stockdb
REDIS_URL=redis://localhost:6379/0
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
CORS_ORIGINS=http://localhost:3000
